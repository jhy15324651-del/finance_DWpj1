# Environment Variables Template
# ===================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows CMD)

# ─── Spring Profile ─────────────────
# 로컬 IntelliJ 실행: dev
# Docker Compose 실행: docker
# EC2/운영: prod
SPRING_PROFILES_ACTIVE=docker

# ─── Database ───────────────────────
# Docker Compose 실행 시: DB_URL은 docker-compose.yml에서 자동 주입
# 로컬 IntelliJ 실행 시: 아래 값을 직접 수정
DB_URL=jdbc:mariadb://localhost:3307/finance_db?createDatabaseIfNotExist=true
DB_USERNAME=jhy
DB_PASSWORD=1234

# MariaDB 컨테이너 설정 (docker-compose가 사용)
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_DATABASE=finance_db
MARIADB_USER=jhy
MARIADB_PASSWORD=1234
DB_PORT=3307

# ─── API Keys ───────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ─── File Paths ─────────────────────
# Docker 컨테이너 내부 경로 (변경 불필요)
TESSERACT_DATAPATH=/usr/share/tesseract-ocr/5/tessdata
FILE_UPLOAD_PATH=/app/uploads
FILE_INFO_UPLOAD_PATH=/app/info_uploads